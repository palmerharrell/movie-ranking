TMDB_API_KEY=

# Frontend -> backend API (see /server). VITE_ prefix is required for Vite
# to expose these to client-side code. VITE_API_TOKEN must match the
# backend's API_TOKEN (server/.env) — bear in mind a bundled frontend
# secret is visible to anyone who loads the app, since the browser must
# send it; this is only meant to keep casual/automated traffic off a
# single-user personal app, not real access control.
VITE_API_URL=http://localhost:3001
VITE_API_TOKEN=
